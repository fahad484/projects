<style>
  .nav-height{
    height: 6rem;
  }
  .search-button{
    background-color: #fe424d;
    width: 100%;
    color: #fff;
    border-radius: 1.4rem;
    padding: 0.5rem 2rem 0.5rem 2rem;
  }
  .search-button:hover{
    background-color: #fe424d;
    color: #fff;
    border-radius: 1.4rem;

  }
  .search-button i{
    display: inline;
  }


  .search-inp{
    border-radius: 1.4rem;
    padding:0.5rem 3rem 0.5rem 3rem;
    /* width: 70%; */
  }


  .search-nav{

    justify-content: center;
    align-items: center;
    padding-left: 5rem;
    
  }
  .select-nav{
    display: flex;
    flex-wrap: wrap;
    justify-content: space-evenly;
    text-align: center;
    width: 60%;
    gap: 0.125rem;
  }
  .select-nav select{
    width:9rem;

  }
  .submit-nav{

    display: flex;
    justify-content: center;
    align-items: center;
  }
</style>
<nav class="navbar nav-height navbar-expand-md navbar-light bg-white border-bottom sticky-top">
  <div class="container-fluid">
    <a class="navbar-brand" href="/listings"><i class="fa-regular fa-compass"></i></a>
    <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNavAltMarkup" >
      <span class="navbar-toggler-icon"></span>
    </button>
    <div class="collapse navbar-collapse" id="navbarNavAltMarkup">
      <div class="navbar-nav">
        <!-- <a class="nav-link "  href="/listings">Home</a> -->
        <a class="nav-link" href="/listings">Explore</a>

      </div>

      
      <div class="navbar-nav  ">
      
        <form method="get" action="/listings/search" class="d-flex  ms-auto search-nav">

          <div class="select-nav">
            <input class="form-control me-2 search-inp" type="search" name="query" placeholder="Search destinations">
            <select class="form-select " name="location">
              <option disabled selected>Location</option> 
              <% if(typeof locations !== "undefined"){ %>
                
            <% locations.forEach(location=> {%>
              <option value="<%= location %>">
                <%= location %>
              </option>
              <% }); %>
              <% } %>
              <option disabled>-</option>
              <option disabled>-</option>
            </select>

            <select class="form-select " name="category">
              <option disabled selected>category</option>
              <% if(typeof categories !== "undefined"){ %>
                
              <% categories.forEach(category=> {%>
                <option value="<%= category %>">
                  <%= category %>
                </option>
                <% }); %>
                <% } %>
                  <option disabled>-</option>
                  <option disabled>-</option>
            </select>

            <select class="form-select " name="price">
              <option disabled selected>Price</option>
              <option value="1000-7000">₹1k - ₹7k</option>
              <option value="8000-15000">₹8k - ₹15k</option>
              <option value="15000">₹15k+</option>
            </select>
          </div>
          
         
          <div class="submit-nav ">
             <button class="btn  search-button" type="submit"><i class="fa-solid fa-magnifying-glass"></i>Search</button>
          </div>
         
           
          
      
        </form>
      
      </div>
      
      
      <div class="navbar-nav ms-auto">
        <a class="nav-link" href="/listings/new"> Airbnb your home</a>

        <% if(!userStatus){ %>
        <a class="nav-link "  href="/signup"><b>Signup</b></a>
        <a class="nav-link" href="/login"><b>Login</b></a>
        <% } %>
        <% if(userStatus){ %>
        <a class="nav-link" href="/logout"><b>Logout</b></a>
        <% } %>
      </div>
    </div>
  </div>
</nav>